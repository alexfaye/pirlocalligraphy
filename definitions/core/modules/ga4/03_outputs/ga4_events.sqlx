config {
    type: "incremental",
    description: "This output event table are ready for Data Studio which is unnested, cleaned, clustered data with several fixes",
    schema: dataform.projectConfig.vars.OUTPUTS_DATASET,
    bigquery: {
        partitionBy: "event_date",
        clusterBy: ["event_date", "session_id"]
    },
    columns: require("includes/core/documentation/helpers.js").ga4Events
}

js{
    const {helpers} = require("includes/core/modules/ga4/helpers.js");
    const config = helpers.getModuleConfig("ga4");

    // check if there is invalid columns or duplicate columns in the custom config
    helpers.checkColumnNames(config);
}

